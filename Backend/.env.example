# Application
APP_NAME=ICMS Backend
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./icms.db
# Docker Compose PostgreSQL defaults:
# POSTGRES_DB=icms
# POSTGRES_USER=icms
# POSTGRES_PASSWORD=change-this-password
# DATABASE_URL=postgresql+psycopg2://icms:change-this-password@db:5432/icms
# Local PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/icms_db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/icms_db

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/icms.log
